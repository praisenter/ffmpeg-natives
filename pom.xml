<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.praisenter</groupId>
    <artifactId>ffmpeg</artifactId>
    <version>8.1-1</version>
    <packaging>pom</packaging>
    <name>Praisenter FFmpeg Binaries</name>
    <description>Classified FFmpeg and FFprobe executable distributions for Praisenter.</description>
    <url>https://github.com/praisenter/ffmpeg-maven</url>
    <licenses>
        <license>
            <name>GNU General Public License, version 3 or later</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
            <distribution>repo</distribution>
            <comments>Binary licensing and corresponding-source availability must be verified for each upstream build before publication.</comments>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>wnbittle</id>
            <name>William Bittle</name>
            <organization>Praisenter</organization>
            <organizationUrl>https://www.praisenter.org</organizationUrl>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/praisenter/ffmpeg-maven.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/praisenter/ffmpeg-maven.git</developerConnection>
        <url>https://github.com/praisenter/ffmpeg-maven</url>
        <tag>HEAD</tag>
    </scm>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>attach-platform-zips</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>target/distributions/ffmpeg-${project.version}-windows-x86_64.zip</file>
                                    <type>zip</type>
                                    <classifier>windows-x86_64</classifier>
                                </artifact>
                                <artifact>
                                    <file>target/distributions/ffmpeg-${project.version}-linux-x86_64.zip</file>
                                    <type>zip</type>
                                    <classifier>linux-x86_64</classifier>
                                </artifact>
                                <artifact>
                                    <file>target/distributions/ffmpeg-${project.version}-macos-x86_64.zip</file>
                                    <type>zip</type>
                                    <classifier>macos-x86_64</classifier>
                                </artifact>
                                <artifact>
                                    <file>target/distributions/ffmpeg-${project.version}-macos-aarch64.zip</file>
                                    <type>zip</type>
                                    <classifier>macos-aarch64</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.4</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.4</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                            <passphraseEnvName>GPG_PASSPHRASE</passphraseEnvName>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>